# ── PostgreSQL Connection ──────────────────────────────────────
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_risk

# ── App Configuration ─────────────────────────────────────────
# How often (in hours) to check for DB changes and rescore
BATCH_INTERVAL_HOURS=48

# Company dashboard port
APP_PORT=8000

# User portal port
USER_APP_PORT=8001

# ── Model Artifacts ───────────────────────────────────────────
MODEL_ARTIFACTS_DIR=src/model/artifacts

# ── Dataset (used by train.py for initial training) ───────────
DATASET_PATH=Datasets/india_credit_risk_dataset_100k.csv
